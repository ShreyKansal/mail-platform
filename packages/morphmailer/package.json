{
  "name": "morphmailer",
  "version": "0.1.0",
  "description": "Typed server-side JavaScript and TypeScript client for the Morphmailer API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }, "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" } } },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "engines": { "node": ">=20.8" },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --target node20 --dts --clean",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "devDependencies": { "@mp/contracts": "workspace:*" }
}
