# MAIL_PLATFORM environment template.
# `node scripts/init-env.mjs` copies this file to .env and generates every secret
# marked <generate>. Paths are relative to each service's package directory
# (services run with cwd = apps/<x> or services/<x>).
# Production values come from the secret manager, never from this file.

NODE_ENV=development
# Local Mailpit development: bypass daily and per-minute recipient quotas. Ignored outside development.
LOCAL_UNLIMITED_SENDING=true
LOG_LEVEL=info
PLATFORM_NAME=MAIL_PLATFORM

# --- PostgreSQL --------------------------------------------------------------
# mp_app: RLS-enforced API role. mp_service: workers (BYPASSRLS). mp_owner: migrations only.
DATABASE_URL=postgres://mp_app:mp_app_dev@127.0.0.1:5432/mail_platform
DATABASE_SERVICE_URL=postgres://mp_service:mp_service_dev@127.0.0.1:5432/mail_platform
DATABASE_MIGRATION_URL=postgres://mp_owner:mp_owner_dev@127.0.0.1:5432/mail_platform

# --- Redis (rate limits, throttles) -------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# --- Secrets -----------------------------------------------------------------
# keyId:base64(32 random bytes). Prepend a new key to rotate; keep old keys for decryption.
ENCRYPTION_KEYS=<generate>
# HMAC key for VERP bounce addresses (>= 32 chars).
VERP_SECRET=<generate>

# --- Platform mail identity --------------------------------------------------
PLATFORM_BOUNCE_DOMAIN=bounces.mail-platform.test
PLATFORM_BOUNCE_MX_HOST=feedback.mail-platform.test
PLATFORM_SPF_INCLUDE=_spf.mail-platform.test
# Public outbound IPs (comma-separated). Empty in local development.
PLATFORM_OUTBOUND_IPS=
# Internal Postfix hand-off (docker-compose publishes it on 127.0.0.1 only).
MTA_HOST=127.0.0.1
MTA_PORT=10025
MTA_ENFORCED_TLS_PORT=10026
# Single local worker serves both queues. Production: run separate pools per stream.
WORKER_STREAMS=transactional,marketing

# --- API ---------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=3000
PUBLIC_API_URL=http://localhost:3000
DASHBOARD_ORIGIN=http://localhost:5173
# GoDaddy Domain Connect (enable only after the service template is approved).
DOMAIN_CONNECT_APPROVED=false
# DOMAIN_CONNECT_PROVIDER_ID=mailer.example.com
# DOMAIN_CONNECT_SERVICE_ID=mail
# DOMAIN_CONNECT_KEY_LABEL=_dcpubkeyv1
# DOMAIN_CONNECT_PRIVATE_KEY=secret-managed RSA private PEM (supports literal \n)
COOKIE_SECURE=false
ALLOW_PUBLIC_SIGNUP=true
RATE_LIMIT_PER_SECOND=10
# Development only: JSON zone file standing in for public DNS (see docs/operations/LOCAL-DEVELOPMENT.md).
DNS_FIXTURE_FILE=../../.data/dns-fixture.json

# --- Webhooks (development relaxations; rejected in production) ---------------
WEBHOOK_ALLOW_HTTP=true
WEBHOOK_ALLOW_PRIVATE_NETWORKS=true

# --- Delivery reconciler -----------------------------------------------------
POSTFIX_LOG_PATH=../../.data/postfix-log/maillog

# --- Bounce processor (Postfix routes VERP DSNs to host.docker.internal:2525) --
BOUNCE_HOST=127.0.0.1
BOUNCE_PORT=2525

# --- SMTP submission ---------------------------------------------------------
SMTP_BIND=127.0.0.1
SMTP_STARTTLS_PORT=2587
SMTP_IMPLICIT_TLS_PORT=2465
