{
  "name": "@mp/smtp-submission",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "tsup src/main.ts --config ../../tsup.config.ts",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mp/contracts": "workspace:*",
    "@mp/core": "workspace:*",
    "@mp/database": "workspace:*",
    "@mp/mail-protocol": "workspace:*",
    "@mp/observability": "workspace:*",
    "@mp/shared": "workspace:*",
    "ioredis": "5.11.1",
    "ipaddr.js": "2.4.0",
    "mailparser": "3.10.0",
    "selfsigned": "2.4.1",
    "smtp-server": "3.20.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/mailparser": "3.9.0",
    "@types/smtp-server": "3.5.13"
  },
  "exports": {
    "./server": "./src/server.ts"
  }
}
