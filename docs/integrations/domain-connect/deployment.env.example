# Publish the template and public-key DNS before enabling.
DOMAIN_CONNECT_APPROVED=false
DOMAIN_CONNECT_PROVIDER_ID=www.mailer.mymorphix.com
DOMAIN_CONNECT_SERVICE_ID=mail
DOMAIN_CONNECT_KEY_LABEL=_dcpubkeyv1
DASHBOARD_ORIGIN=https://www.mailer.mymorphix.com
# Inject DOMAIN_CONNECT_PRIVATE_KEY from your secret manager.
# Local development key: .data/domain-connect/signing-key.pem (never commit or publish).
