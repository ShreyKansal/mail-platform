{
  "name": "@mp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsup src/server.ts --config ../../tsup.config.ts",
    "start": "node --enable-source-maps dist/server.js",
    "openapi": "tsx src/export-openapi.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "dev:publish-dns": "tsx --env-file=../../.env src/dev/publish-dns.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "5.2.6",
    "@mp/contracts": "workspace:*",
    "@mp/core": "workspace:*",
    "@mp/database": "workspace:*",
    "@mp/dns-verification": "workspace:*",
    "@mp/mail-protocol": "workspace:*",
    "@mp/observability": "workspace:*",
    "@mp/permissions": "workspace:*",
    "@mp/shared": "workspace:*",
    "@node-rs/argon2": "2.2.2",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "4.0.2",
    "ioredis": "5.11.1",
    "zod": "3.25.76"
  },
  "exports": {
    "./app": "./src/app.ts",
    "./config": "./src/config.ts"
  }
}
